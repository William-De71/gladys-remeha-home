{
  "name": "gladys-remeha-home",
  "version": "0.1.1",
  "private": true,
  "description": "External Gladys Assistant integration for Remeha Home (BDR Thermea cloud): climate zones as thermostats, hot water with boost, holiday mode, water pressure, outdoor temperature and energy index, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-remeha-home",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-remeha-home.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "remeha",
    "remeha-home",
    "bdr-thermea",
    "baxi",
    "de-dietrich",
    "brotje",
    "boiler",
    "heat-pump",
    "thermostat",
    "home-automation"
  ]
}
